# ============================================
# AI LeadGen System - Root env template
# ============================================
# This is a high-level overview. The backend reads backend/.env and the
# frontend reads frontend/.env (CRA only exposes REACT_APP_* vars to the browser).
# See backend/.env.example and frontend/.env.example for the full lists.

# --- Server ---
PORT=5001
NODE_ENV=development

# CORS allow-list (comma-separated). Used by the backend.
ALLOWED_ORIGINS=http://localhost:3000

# --- Storage driver (S1) ---
# auto (default) = Firestore if configured, else JSON file | json | firestore | postgres
STORAGE_DRIVER=auto
# Required only when STORAGE_DRIVER=postgres (Supabase/Postgres connection string).
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Auth & workspace isolation (S2) ---
# disabled (default) = no auth, single default workspace (pre-S2 behavior)
# supabase | dev | clerk. See backend/.env.example for details.
AUTH_MODE=disabled
DEFAULT_WORKSPACE_ID=default
# Required when AUTH_MODE=supabase (Supabase JWT secret).
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# --- Scraping (SerpAPI / Google Maps engine) ---
# Required for /api/scrape. Get a key at https://serpapi.com
SERPAPI_KEY=your_serpapi_key

# --- Firebase / Firestore (optional; file-based fallback used if unset) ---
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=your_client_email

# --- Frontend (build-time) ---
# Base URL of the API. Leave empty to use same-origin (backend serves the build).
REACT_APP_API_URL=http://localhost:5001
# Frontend auth mode (must match backend AUTH_MODE intent): disabled (default) | supabase
REACT_APP_AUTH_MODE=disabled
# Public Supabase project URL + anon key (only when REACT_APP_AUTH_MODE=supabase).
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
