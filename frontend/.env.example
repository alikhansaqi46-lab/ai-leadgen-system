# ============================================
# AI LeadGen System - Frontend (CRA) Environment Variables
# ============================================
# Only variables prefixed with REACT_APP_ are embedded into the build and are
# therefore PUBLIC. Never put secrets (API keys, tokens) here — they ship to the
# browser in plain text.

# Base URL of the backend API.
# Leave empty ("") to use the same origin (backend serves the React build).
REACT_APP_API_URL=http://localhost:5001

# NOTE: There is intentionally no REACT_APP_OPENAI_API_KEY.
# AI generation must go through a server-side endpoint (added in S5) so the
# OpenAI key is never exposed in the client bundle.

# --- Auth (S2) ---
# disabled (default) = no login screen; app behaves exactly as pre-S2.
# supabase           = require a Supabase session (set the two values below).
REACT_APP_AUTH_MODE=disabled
# Public Supabase project URL + anon key (safe to expose; only used when supabase).
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
