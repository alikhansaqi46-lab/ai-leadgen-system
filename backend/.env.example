# ============================================
# AI LeadGen System - Backend Environment Variables
# ============================================

# Server Configuration
PORT=5001
NODE_ENV=development

# Base URL used for constructing OAuth redirect URIs and uploaded image URLs.
# Must match the public URL where this backend is reachable.
# Local dev: http://localhost:5001
# Production: https://api.yourdomain.com
API_BASE_URL=http://localhost:5001

# CORS allow-list (comma-separated list of allowed origins).
# Example: https://app.example.com,https://staging.example.com
# Falls back to FRONTEND_URL, then http://localhost:3000 if unset.
ALLOWED_ORIGINS=http://localhost:3000
# FRONTEND_URL is a single-origin fallback kept for backwards compatibility.
FRONTEND_URL=http://localhost:3000

# --- Storage driver (S1) ---
# Selects where leads are persisted:
#   auto (default) = PostgreSQL if DATABASE_URL is set, else file JSON
#   json           = force file-based JSON (backend/data/leads.json)
#   postgres       = use PostgreSQL / Supabase (requires DATABASE_URL)
STORAGE_DRIVER=auto

# PostgreSQL / Supabase connection string (required only when STORAGE_DRIVER=postgres).
# Supabase: Project Settings → Database → Connection string (URI).
DATABASE_URL=postgres://user:password@host:5432/dbname
# SSL: auto (on for remote hosts, off for localhost). Override with require|disable.
# PGSSL=require

# --- Auth & workspace isolation (S2) ---
# Selects how requests are authenticated and which workspace they resolve to:
#   disabled           = no token required; everything uses DEFAULT_WORKSPACE_ID (LOCAL DEV ONLY)
#   local              = LeadFlow JWT auth (recommended for production with /api/auth)
#   supabase           = verify Supabase JWTs (ES256/RS256 via JWKS, or legacy HS256)
#   dev                = verify locally HMAC-signed JWTs (DEV_AUTH_SECRET) — testing only
# Production lock REFUSES AUTH_MODE=disabled|dev.
AUTH_MODE=local
DEFAULT_WORKSPACE_ID=default

# Required for AUTH_MODE=local (and encryption fallback). Production: >=32 random chars.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# AES-256-GCM key for OpenAI keys + integration credentials (64 hex chars = 256 bits).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production lock REQUIRES this to be set.
# ENCRYPTION_KEY=

# Optional dedicated secret for email open/click tracking HMAC (falls back to ENCRYPTION_KEY / JWT_SECRET).
# EMAIL_TRACKING_SECRET=

# Max upload size for /api/upload-image (bytes). Default 5MB.
# UPLOAD_MAX_BYTES=5242880

# --- Supabase JWT verification (when AUTH_MODE=supabase) ---
# Current Supabase projects sign access tokens with ASYMMETRIC keys (ES256/RS256)
# and expose a public JWKS endpoint. Set SUPABASE_URL (the project URL) and the
# backend verifies tokens against {SUPABASE_URL}/auth/v1/.well-known/jwks.json.
# No secret is needed for this path.
SUPABASE_URL=https://your-project-ref.supabase.co
# Optional explicit override of the JWKS endpoint (defaults to the URL above).
# SUPABASE_JWKS_URL=
# LEGACY ONLY: older projects that still expose an HS256 "JWT Secret" can set this
# instead of SUPABASE_URL. If both are set, JWKS (SUPABASE_URL) takes precedence.
# SUPABASE_JWT_SECRET=your_supabase_jwt_secret
# Local-only signing secret for AUTH_MODE=dev (never use in production).
DEV_AUTH_SECRET=change-me-dev-only

# --- TLS ---
# Certificate verification is ON by default for SMTP/IMAP/Postgres.
# Only set TLS_INSECURE_ALLOW=true for local debugging behind a broken corporate CA.
# Production lock FORBIDS TLS_INSECURE_ALLOW=true.
# TLS_INSECURE_ALLOW=false
# Prefer fixing trust: point at your corporate/root CA PEM (appended to Node roots):
# TLS_CA_FILE=C:\path\to\corp-root.pem
# NODE_EXTRA_CA_CERTS=C:\path\to\corp-root.pem
# Supabase pooler uses Supabase Root 2021 CA (not in public trust stores).
# After extracting once via: node --use-system-ca scripts/fix-supabase-pg-tls.js
# the file backend/certs/supabase-root-2021.pem is auto-loaded by config/tls.js.
# Also start Node with --use-system-ca so JWKS/HTTPS to supabase.co works behind corporate TLS inspection:
#   npm start   (already passes --use-system-ca)

# --- Rate limits (requests per window; optional overrides) ---
# RATE_LIMIT_API_MAX=600
# RATE_LIMIT_AUTH_MAX=40
# RATE_LIMIT_SEND_MAX=120
# RATE_LIMIT_WEBHOOK_MAX=300
# TRUST_PROXY=true

# External automation webhooks (/api/webhook/*) — required in production
# WEBHOOK_SECRET=
# Optional alias for email inbound receive webhook
# EMAIL_WEBHOOK_SECRET=

# Super-admins (comma-separated emails) — auto enterprise + verified
# SUPER_ADMIN_EMAILS=leadflow.my@gmail.com

# Owner OpenAI usage panel (Super Admin → AI Usage)
# Optional: show remaining balance when live OpenAI billing API is unavailable
# OPENAI_CREDIT_BALANCE_USD=50
# OPENAI_MONTHLY_BUDGET_USD=100
# OPENAI_ADMIN_KEY=                 # org admin key if you have billing API access
# OPENAI_COST_INPUT_PER_1K=0.00015
# OPENAI_COST_OUTPUT_PER_1K=0.0006

# System Health probes (Owner Console)
# Render tile stays Unconfigured unless this is set to the real Render health URL
# RENDER_HEALTH_URL=https://your-service.onrender.com/health
# HOSTINGER_HEALTH_URL=https://your-hostinger-site.example
# DOMAIN_HEALTH_URL=https://app.yourdomain.com

# --- AI Sales Agent (S5) ---
# Selects how AI features (qualification, outreach) are produced:
#   heuristic (default) = deterministic scoring + templates. No API key, free, demoable.
#   openai              = real LLM via OPENAI_API_KEY (reserved; not wired yet).
# The numeric qualification score is ALWAYS deterministic regardless of mode.
AI_MODE=heuristic
# OPENAI_API_KEY=sk-...           # only when AI_MODE=openai (future)
# OPENAI_MODEL=gpt-4o-mini

# --- Scraping (SerpAPI, Google Maps engine) ---
# REQUIRED for /api/scrape. There is no default; scraping returns 503 if unset.
# Get a key at https://serpapi.com
SERPAPI_KEY=your_serpapi_key

# Email Configuration (Gmail SMTP) — optional; email sending is disabled if unset
# Legacy SMTP fallback (used when OAuth is not connected)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Gmail API tuning (optional)
# Inbox Gmail sync — only while Inbox page is open (default 5 min interval)
# INBOX_POLL_INTERVAL_MS=300000
# INBOX_INITIAL_SYNC_DELAY_MS=3000
# GMAIL_SYNC_MAX_RESULTS=15
# GMAIL_QUEUE_DELAY_MS=300
# GMAIL_SEND_TIMEOUT_MS=45000
# GMAIL_DEBUG=false

# --- Google OAuth 2.0 (Email OAuth) ---
# Required for the one-click "Connect Gmail" / "Connect Google Workspace" flow.
# Create credentials at https://console.cloud.google.com/apis/credentials
# 1. Create a project (or use existing)
# 2. Enable Gmail API: https://console.cloud.google.com/apis/library/gmail.googleapis.com
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add Authorized redirect URI: http://localhost:5001/api/integrations/email/oauth/callback
#    (or your production domain + /api/integrations/email/oauth/callback)
# 5. Copy Client ID and Client Secret below
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# WhatsApp Business API Configuration
# Provider used by the server.js /api/send-whatsapp path: 'twilio' or 'meta'.
# (The primary UI uses the Meta routes under /api/whatsapp/*.)
WHATSAPP_PROVIDER=meta

# --- Twilio SMS Configuration ---
# Credentials are stored at runtime via Settings → Integrations → SMS → Connect.
# These env vars act as a fallback / initial setup only.
# Get credentials at https://console.twilio.com
TWILIO_SMS_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_SMS_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_SMS_PHONE_NUMBER=+1234567890
# Public base URL Twilio uses when signing webhooks (must match configured callback URL host).
# TWILIO_WEBHOOK_BASE_URL=https://api.yourdomain.com
# Also used: TWILIO_AUTH_TOKEN (alias) for X-Twilio-Signature verification on /api/sms/webhook + /status-callback.

# --- Twilio Configuration (only if WHATSAPP_PROVIDER=twilio) ---
# Get from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Format: whatsapp:+1234567890 (must be a Twilio WhatsApp-enabled number)
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# --- WhatsApp transport (QR primary) ---
# Default: qr — users scan QR with WhatsApp Business (Linked Devices). No Meta tokens required.
# Optional: meta — legacy Meta Cloud API (Access Token + Phone Number ID).
WHATSAPP_TRANSPORT=qr
# Wait for Baileys open when restoring an existing session (ms)
# WHATSAPP_CONNECT_WAIT_MS=45000
# Encrypt WhatsApp session files at rest (AES-GCM). Falls back to JWT_SECRET if unset.
# ENCRYPTION_KEY=

# --- Meta Cloud API (optional, only when WHATSAPP_TRANSPORT=meta) ---
# WHATSAPP_TOKEN=EAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PHONE_NUMBER_ID=1xxxxxxxxxxxxxx
# WHATSAPP_BUSINESS_ACCOUNT_ID=1xxxxxxxxxxxxxx
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=leadgen-verify-token
# WHATSAPP_APP_SECRET=

# WhatsApp Test Mode
# Set to 'true' to simulate sends without actually sending (logs only)
WHATSAPP_TEST_MODE=false

# --- Follow-up background worker ---
# Processes overdue WhatsApp follow-ups across workspaces.
# FOLLOWUP_WORKER_ENABLED=true
# FOLLOWUP_WORKER_INTERVAL_MS=60000

# --- PayPal Subscriptions ---
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# PAYPAL_PLAN_STARTER=
# PAYPAL_PLAN_PRO=
# PAYPAL_PLAN_AGENCY=
# Webhook ID from PayPal Developer Dashboard → Webhooks (required to verify signatures)
# PAYPAL_WEBHOOK_ID=

# --- AI (server-side) ---
# The OpenAI key MUST live on the backend only — never expose it to the browser.
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o-mini
# FREE_AI_MESSAGES=100
# COMPANY_NAME=LeadFlow AI
