# ============================================
# AI LeadGen System - Environment Variables
# ============================================

# Server Configuration
PORT=5001
NODE_ENV=development

# Email Configuration (Gmail SMTP)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# WhatsApp Business API Configuration
# Choose provider: 'twilio' or 'meta'
WHATSAPP_PROVIDER=twilio

# --- Twilio Configuration ---
# Get from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Format: whatsapp:+1234567890 (must be a Twilio WhatsApp-enabled number)
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# --- Meta Cloud API Configuration ---
# Get from https://developers.facebook.com/apps
WHATSAPP_TOKEN=EAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PHONE_NUMBER_ID=1xxxxxxxxxxxxxx

# WhatsApp Test Mode
# Set to 'true' to simulate sends without actually sending (logs only)
WHATSAPP_TEST_MODE=false

# Firebase Configuration (for database)
# Download serviceAccountKey.json from Firebase Console
FIREBASE_PROJECT_ID=your-project-id
