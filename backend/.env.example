# ============================================
# AI LeadGen System - Backend Environment Variables
# ============================================

# Server Configuration
PORT=5001
NODE_ENV=development

# CORS allow-list (comma-separated list of allowed origins).
# Example: https://app.example.com,https://staging.example.com
# Falls back to FRONTEND_URL, then http://localhost:3000 if unset.
ALLOWED_ORIGINS=http://localhost:3000
# FRONTEND_URL is a single-origin fallback kept for backwards compatibility.
FRONTEND_URL=http://localhost:3000

# --- Storage driver (S1) ---
# Selects where leads are persisted:
#   auto (default) = Firestore if configured, else file JSON (legacy behavior)
#   json           = force file-based JSON (backend/data/leads.json)
#   firestore      = force Firestore
#   postgres       = use PostgreSQL / Supabase (requires DATABASE_URL)
STORAGE_DRIVER=auto

# PostgreSQL / Supabase connection string (required only when STORAGE_DRIVER=postgres).
# Supabase: Project Settings → Database → Connection string (URI).
DATABASE_URL=postgres://user:password@host:5432/dbname
# SSL: auto (on for remote hosts, off for localhost). Override with require|disable.
# PGSSL=require

# --- Scraping (SerpAPI, Google Maps engine) ---
# REQUIRED for /api/scrape. There is no default; scraping returns 503 if unset.
# Get a key at https://serpapi.com
SERPAPI_KEY=your_serpapi_key

# Email Configuration (Gmail SMTP) — optional; email sending is disabled if unset
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# WhatsApp Business API Configuration
# Provider used by the server.js /api/send-whatsapp path: 'twilio' or 'meta'.
# (The primary UI uses the Meta routes under /api/whatsapp/*.)
WHATSAPP_PROVIDER=meta

# --- Twilio Configuration (only if WHATSAPP_PROVIDER=twilio) ---
# Get from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Format: whatsapp:+1234567890 (must be a Twilio WhatsApp-enabled number)
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# --- Meta Cloud API Configuration ---
# Get from https://developers.facebook.com/apps
# These act as an env fallback; credentials can also be saved at runtime via
# POST /api/whatsapp/credentials.
WHATSAPP_TOKEN=EAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PHONE_NUMBER_ID=1xxxxxxxxxxxxxx
WHATSAPP_BUSINESS_ACCOUNT_ID=1xxxxxxxxxxxxxx
# Token used to verify the Meta webhook subscription (Meta Developers → Webhook).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=leadgen-verify-token

# WhatsApp Test Mode
# Set to 'true' to simulate sends without actually sending (logs only)
WHATSAPP_TEST_MODE=false

# --- Firebase / Firestore (optional) ---
# If unset, the backend falls back to file-based JSON storage in backend/data/.
# Either download serviceAccountKey.json into backend/, OR set the vars below.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_PRIVATE_KEY=your-private-key

# --- AI (server-side, reserved for S5) ---
# The OpenAI key MUST live on the backend only — never expose it to the browser.
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
